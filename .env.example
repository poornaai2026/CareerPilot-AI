# ==========================================
# CareerPilot AI Configuration
# ==========================================

# 1. LLM API Key (OpenRouter or Google AI Studio)
# Get OpenRouter key from https://openrouter.ai/keys (Recommended)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: Google AI Studio Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Gmail Inbox Harvester
# Reads incoming LinkedIn and Naukri job alert digest emails
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
GMAIL_MAX_AGE_DAYS=7

# 3. Application Preferences & Safety Rules
# When AUTO_SUBMIT=false, the agent navigates, fills all fields, uploads resume, answers questions,
# and stages it for your 1-click review.
# When AUTO_SUBMIT=true, high-scoring matches (>= MATCH_SCORE_THRESHOLD) are submitted automatically.
AUTO_SUBMIT=false
MATCH_SCORE_THRESHOLD=75
DAILY_APPLICATION_LIMIT=20

# 4. Browser & Session Management
BROWSER_HEADLESS=false
CHROME_CDP_URL=http://127.0.0.1:9222
BROWSER_USER_DATA_DIR=chrome_debug_profile

# 5. Resume Path
RESUME_PATH=resumes/resume.pdf
HARVESTER_MODE=BROWSER

# 6. Commercial Licensing & Payments (Optional)
CAREERPILOT_LICENSE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


